BasedOnStyle: LLVM

# Enforce braces on single-statement 'if', 'else', 'for', 'while', and 'do'
InsertBraces: true

# Black conventions: 88-char column limit and 4-space indentation
ColumnLimit: 88
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Black-style brace placement (inline open, dedicated closing line)
BreakBeforeBraces: Attach

# Black splits collection items one per line when wrapped
BinPackArguments: false
BinPackParameters: false

# Alignment of function calls etc
AlignAfterOpenBracket: BlockIndent
AlignTrailingComments: false
AlignOperands: DontAlign  # undecided but think prefer :)
InsertTrailingCommas: Wrapped

# Prevent cramming short blocks or functions onto a single line
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Clean spacing around operators
SpaceBeforeParens: ControlStatements
SpacesInAngles: false

# Extra things that may do nothing on top of alignment of function calls?
ContinuationIndentWidth: 4
PenaltyBreakBeforeFirstCallParameter: 0
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None

# Just C++ things, independent of black style
# modern C++ type-centric philosophy, rather than C philosophy
PointerAlignment: Left

